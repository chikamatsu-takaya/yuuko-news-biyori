# -----------------------------------------------
# Yuuko News - Environment Variables Example
# -----------------------------------------------
# Do NOT commit real secrets.
# This file is only an example for local setup.
#
# NOTE:
# The Rust side reads GEMINI_API_KEY at runtime.
# When running `pnpm tauri dev`, make sure this value is available
# in your shell/OS environment.

GEMINI_API_KEY=your-gemini-api-key

# Optional (local debugging)
# RUST_LOG=info
