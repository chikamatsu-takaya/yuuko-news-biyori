{
  "name": "my-project",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "node --test",
    "test:post-merge-status": "node --test task-management/post-merge-firestore-status.test.mjs",
    "test:ui": "playwright test",
    "test:ui:headed": "playwright test --headed",
    "test:ui:report": "playwright show-report",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check:frontend": "pnpm run lint && pnpm run typecheck && pnpm run test",
    "check:rust": "cargo check --manifest-path src-tauri/Cargo.toml",
    "check:rust:test": "cargo test --manifest-path src-tauri/Cargo.toml",
    "check:rust:fmt": "cargo fmt --manifest-path src-tauri/Cargo.toml --all -- --check",
    "check:rust:clippy": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "review:quick": "pnpm run check:frontend && pnpm run check:rust && pnpm run check:rust:test",
    "review:strict": "pnpm run review:quick && pnpm run build && pnpm run check:rust:fmt && pnpm run check:rust:clippy",
    "review": "pnpm run review:strict",
    "setup:dev-news-source": "node scripts/setup-dev-news-source.mjs",
    "hooks:install": "git config --local core.hooksPath .githooks"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.1",
    "@radix-ui/react-accordion": "1.2.12",
