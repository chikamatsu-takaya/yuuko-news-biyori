    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9.38.0",
    "eslint-config-next": "16.2.11",
    "postcss": "^8.5.12",
    "tailwindcss": "^4.2.0",
    "tw-animate-css": "1.3.3",
    "typescript": "5.7.3"
  }
